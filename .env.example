# --- Database (required) ---
# Local-first SQLite. Swap for a Postgres URL later without code changes.
DATABASE_URL="file:./dev.db"

# --- Submission safety (optional) ---
# Master switch for actually sending applications.
#   dry_run (default) = prepare + record everything, submit NOTHING.
#   live              = attempt real submission (requires Playwright installed).
APPLY_MODE="dry_run"
# Per-ATS live auto-submit guards (only used when APPLY_MODE=live).
# GH_AUTO_SUBMIT="1"
# LEVER_AUTO_SUBMIT="1"

# --- Resume parsing (optional) ---
# If set, Refresh Profile uses OpenAI to parse your resume.
# If unset, a deterministic, dependency-free fallback parser is used.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# --- Enhanced Judge provider priority (optional) ---
# This is an explicit server-side availability signal, not auto-detection.
# Set exactly to 1 only while GitHub Copilot is actually connected to the
# running app. Copilot then has priority and OpenAI/Anthropic are never called.
# When unset, configure a fallback provider and key in Settings. Those keys are
# stored server-side in local SQLite and are not read from this file.
# COPILOT_JUDGE_CONNECTED="1"

# --- Scheduled scanner (optional; used by `npm run cron`) ---
# Cron expression for how often to scan the active discovery catalog.
# Default: every 20 minutes.
SCAN_CRON="*/20 * * * *"
# Set to 0 to skip the immediate scan when the cron process starts.
SCAN_ON_START="1"

# --- New-internship notifications (optional) ---
# Keep this secret and local. A message is sent only for internships first seen
# during the completed discovery run; existing rows are never backfilled.
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/.../..."
# Dashboard Strong fit starts at 70. Raise this for fewer, stricter alerts.
DISCORD_MIN_FIT_SCORE="70"
# Require a source-provided posting time within this many minutes. Jobs with no
# posting timestamp are intentionally omitted from Discord.
DISCORD_MAX_POST_AGE_MINUTES="60"
